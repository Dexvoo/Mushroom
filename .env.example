# Copy to .env and fill in. Optional values can be left empty (or set to 'none').
# Startup stops with a clear error if a required value is missing or an ID isn't a Discord ID.

# --- Required ---

# MongoDB connection string
MONGO_URI=''

# Developer mode: 'true' uses the *_DEV token and application ID below and registers
# all commands to DEV_GUILD_ID only. Anything else (or empty) runs in production.
DEVELOPER_MODE='false'

# Production bot (required when DEVELOPER_MODE is not 'true')
BOT_TOKEN=''
BOT_APPLICATION_ID=''

# Development bot (required when DEVELOPER_MODE is 'true')
BOT_TOKEN_DEV=''
BOT_APPLICATION_ID_DEV=''

# --- Optional ---

# Default language (i18n locale code). Defaults to en-GB.
DEFAULT_LANGUAGE='en-GB'

# Developer guild: developer-only commands are registered here, and dev logs are sent here.
# Without it, developer-only commands are registered globally and dev logs are skipped.
DEV_GUILD_ID=''

# Comma-separated Discord user IDs allowed to use developer-only commands
DEVELOPER_IDS=''

# Dev log channels in DEV_GUILD_ID. Leave any empty to turn that log off.
COMMAND_CID=''
JOIN_GUILD_CID=''
LEAVE_GUILD_CID=''
USER_LEVEL_CID=''
VOTE_CID=''
